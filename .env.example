# --- Database (Supabase Postgres) ---
# Project Settings → Database → Connection string → URI (use "Transaction" / pooler for serverless)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (optional, for prisma migrate / db push if pooler fails)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase Storage (admin photo uploads) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Project Settings → API → service_role (secret — server only, never in the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional anon key if you add client-side Supabase later
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Admin ---
ADMIN_PASSWORD="change-me"
ADMIN_SECRET="long-random-secret-at-least-32-chars"
CUSTOMER_SECRET="another-long-random-secret-at-least-32-chars"

# --- Paystack ---
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"

# --- Order emails (Resend) ---
# https://resend.com → API Keys. Verify flowerroom.ng so mail can be sent from the domain.
RESEND_API_KEY="re_xxx"
RESEND_FROM="Flower Room <orders@flowerroom.ng>"
# Shop inbox. Falls back to the email saved in admin settings.
ORDER_NOTIFY_EMAIL="theroomng@gmail.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
WHATSAPP_NUMBER="2349155353128"
NEXT_PUBLIC_WHATSAPP_NUMBER="2349155353128"
NEXT_PUBLIC_PHONE="+234 915 535 3128"
